datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"   
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id         Int      @id @default(autoincrement())
  fullName   String
  jobTitle   String
  country    String
  salary     Float
  department String
  createdAt  DateTime @default(now())
}